---
const CTA_URL = 'https://app.nuravetcare.com/login';
---

<section
  class="relative overflow-hidden"
  style="background: var(--gradient-hero); padding-top: 6rem; min-height: 100svh; display: flex; align-items: center; width: 100%;"
>
  <!-- Dot-grid overlay -->
  <div class="dot-grid" style="position: absolute; inset: 0; pointer-events: none;"></div>

  <!-- Glow blobs -->
  <div style="position: absolute; top: 5rem; right: 2.5rem; width: 20rem; height: 20rem; border-radius: 50%; background: radial-gradient(circle, rgba(124,58,237,0.15) 0%, transparent 70%); filter: blur(40px); pointer-events: none;"></div>
  <div style="position: absolute; bottom: 5rem; left: 2.5rem; width: 24rem; height: 24rem; border-radius: 50%; background: radial-gradient(circle, rgba(67,56,202,0.12) 0%, transparent 70%); filter: blur(50px); pointer-events: none;"></div>

  <div class="container" style="padding-top: 4rem; padding-bottom: 6rem; position: relative; z-index: 10;">
    <div class="hero-grid">

      <!-- Left — Copy -->
      <div>
        <div class="fade-up">
          <span class="section-label">Software Veterinario #1 en Latam</span>
        </div>

        <h1 class="fade-up fade-up-delay-1" style="margin-top: 1rem; font-size: clamp(2.2rem, 5vw, 3.5rem); font-weight: 800; line-height: 1.15; letter-spacing: -0.02em; color: var(--color-text);">
          Gestiona tu clínica.<br />
          <span class="gradient-text">Cuida mejor</span> a tus<br />
          pacientes.
        </h1>

        <p class="fade-up fade-up-delay-2" style="margin-top: 1.5rem; font-size: 1.125rem; line-height: 1.75; color: var(--color-text-muted); max-width: 480px;">
          Nura VetCare centraliza historiales clínicos, citas, medicaciones y propietarios
          en una plataforma moderna. Sin papeles. Sin caos. Solo resultados.
        </p>

        <div class="fade-up fade-up-delay-3" style="display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 2rem;">
          <a href={CTA_URL} class="btn-primary">
            Empieza gratis — 14 días
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
          <a href="#features" class="btn-secondary">
            Ver funciones
          </a>
        </div>

        <!-- Trust badges -->
        <div class="fade-up fade-up-delay-4" style="display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.5rem; margin-top: 2rem;">
          {[
            'Sin tarjeta de crédito',
            'Configuración en 5 min',
            'Soporte en español',
          ].map(badge => (
            <div style="display: flex; align-items: center; gap: 0.4rem;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-primary); flex-shrink: 0;">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
              </svg>
              <span style="font-size: 0.875rem; font-weight: 500; color: var(--color-text-2); white-space: nowrap;">{badge}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Right — Visual mockup -->
      <div class="fade-up fade-up-delay-2" style="position: relative; display: flex; justify-content: center;">
        <!-- Dashboard card mockup -->
        <div class="glass-card" style="padding: 1.5rem; width: 100%; max-width: 28rem; border-radius: 1.5rem;">
          <!-- Header -->
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.25rem;">
            <div>
              <p style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-primary);">Resumen del día</p>
              <p style="font-weight: 700; font-size: 1.25rem; margin-top: 0.2rem; color: var(--color-text);">Clínica VetPro</p>
            </div>
            <div style="width: 2.5rem; height: 2.5rem; border-radius: 0.75rem; display: flex; align-items: center; justify-content: center; background: var(--gradient-brand);">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>
              </svg>
            </div>
          </div>

          <!-- Stats row -->
          <div style="display: grid; grid-template-columns: repeat(3,1fr); gap: 0.75rem; margin-bottom: 1.25rem;">
            {[
              { label: 'Pacientes', value: '124', icon: '🐾', color: '#7c3aed' },
              { label: 'Citas hoy', value: '8',   icon: '📅', color: '#4338ca' },
              { label: 'Pendientes', value: '3',  icon: '⏰', color: '#7c3aed' },
            ].map(stat => (
              <div style={`border-radius: 0.75rem; padding: 0.75rem; text-align: center; background: linear-gradient(135deg, ${stat.color}18, ${stat.color}08);`}>
                <p style="font-size: 1.25rem; margin-bottom: 0.25rem;">{stat.icon}</p>
                <p style="font-weight: 700; font-size: 1.1rem; line-height: 1; color: var(--color-text);">{stat.value}</p>
                <p style="font-size: 0.7rem; margin-top: 0.25rem; color: var(--color-text-muted);">{stat.label}</p>
              </div>
            ))}
          </div>

          <!-- Patient list -->
          <div>
            <p style="font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-text-muted); margin-bottom: 0.75rem;">Próximas citas</p>
            <div style="display: flex; flex-direction: column; gap: 0.625rem;">
              {[
                { name: 'Max',  species: 'Golden Retriever', time: '09:00', owner: 'C. Ramírez', bg: 'linear-gradient(135deg,#fbbf24,#f97316)' },
                { name: 'Luna', species: 'Gato Persa',       time: '10:30', owner: 'M. Torres',  bg: 'linear-gradient(135deg,#a78bfa,#7c3aed)' },
                { name: 'Kiwi', species: 'Loro Amazónico',   time: '11:15', owner: 'A. López',   bg: 'linear-gradient(135deg,#34d399,#059669)' },
              ].map(p => (
                <div style="display: flex; align-items: center; gap: 0.75rem; border-radius: 0.75rem; padding: 0.625rem 0.75rem; background: rgba(255,255,255,0.6);">
                  <div style={`width: 2.25rem; height: 2.25rem; border-radius: 0.5rem; background: ${p.bg}; display: flex; align-items: center; justify-content: center; color: #fff; font-weight: 700; font-size: 0.875rem; flex-shrink: 0;`}>
                    {p.name[0]}
                  </div>
                  <div style="flex: 1; min-width: 0;">
                    <p style="font-weight: 600; font-size: 0.875rem; color: var(--color-text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">{p.name}</p>
                    <p style="font-size: 0.75rem; color: var(--color-text-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">{p.species} · {p.owner}</p>
                  </div>
                  <span style="font-size: 0.75rem; font-weight: 600; padding: 0.2rem 0.5rem; border-radius: 0.4rem; background: var(--color-primary-light); color: var(--color-primary); flex-shrink: 0;">{p.time}</span>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Floating badge -->
        <div class="glass-card" style="position: absolute; top: -1rem; right: -1rem; padding: 0.5rem 1rem; border-radius: 999px; box-shadow: var(--shadow-hover); display: flex; align-items: center; gap: 0.5rem;">
          <span style="color: #22c55e; font-size: 0.875rem;">●</span>
          <span style="font-size: 0.8rem; font-weight: 600; color: var(--color-text); white-space: nowrap;">500+ clínicas activas</span>
        </div>
      </div>

    </div>
  </div>

  <!-- Wave divider -->
  <div style="position: absolute; bottom: 0; left: 0; right: 0;">
    <svg viewBox="0 0 1440 80" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none" style="width:100%;height:80px;display:block;">
      <path d="M0 80L1440 80L1440 20C1200 70 900 0 720 20C540 40 240 0 0 20Z" fill="#f9f7ff"/>
    </svg>
  </div>
</section>
