---

<section id="features" style="padding: 6rem 0; background: var(--color-bg); width: 100%;">
  <div class="container">

    <!-- Header -->
    <div class="fade-up" style="text-align: center; margin-bottom: 4rem;">
      <span class="section-label">Funciones</span>
      <h2 style="font-size: clamp(1.75rem, 4vw, 2.5rem); font-weight: 800; color: var(--color-text); margin-top: 1rem; line-height: 1.2;">
        Todo lo que tu clínica necesita,<br />
        <span class="gradient-text">en una sola plataforma</span>
      </h2>
      <p style="margin-top: 1rem; font-size: 1.05rem; color: var(--color-text-muted); max-width: 36rem; margin-left: auto; margin-right: auto; line-height: 1.6;">
        Diseñado por veterinarios, para veterinarios. Cada función resuelve un problema real de la clínica.
      </p>
    </div>

    <!-- Features grid -->
    <div class="features-grid">
      {features.map((f, i) => (
        <div
          class={`glass-card fade-up fade-up-delay-${(i % 3) + 1}`}
          style="padding: 1.75rem; display: flex; flex-direction: column; gap: 1rem;"
        >
          <!-- Icon box -->
          <div style={`width: 3rem; height: 3rem; border-radius: 0.75rem; display: flex; align-items: center; justify-content: center; background: ${f.bg}; flex-shrink: 0;`}>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke={f.color} stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d={f.icon}/>
            </svg>
          </div>
          <!-- Badge -->
          <span style={`display: inline-block; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: ${f.color}; background: ${f.bg}; padding: 0.2rem 0.65rem; border-radius: 999px; width: fit-content;`}>
            {f.badge}
          </span>
          <!-- Text -->
          <div>
            <h3 style="font-size: 1.05rem; font-weight: 700; color: var(--color-text); margin-bottom: 0.5rem;">{f.title}</h3>
            <p style="font-size: 0.875rem; line-height: 1.65; color: var(--color-text-muted);">{f.desc}</p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
