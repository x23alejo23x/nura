---
const CTA_URL = 'https://app.nuravetcare.com/login';
---

<nav style="position: fixed; top: 0; left: 0; right: 0; z-index: 50; padding: 0.75rem 1rem;">
  <div class="container">
    <div class="glass-card" style="display: flex; align-items: center; justify-content: space-between; padding: 0.75rem 1.25rem; border-radius: 1rem;">

      <!-- Logo -->
      <a href="/" style="display: flex; align-items: center; gap: 0.5rem; text-decoration: none;">
        <div style="width: 2rem; height: 2rem; border-radius: 0.5rem; display: flex; align-items: center; justify-content: center; background: var(--gradient-brand); flex-shrink: 0;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 16V8a2 2 0 0 0-1-1.73l-6-3.46a2 2 0 0 0-2 0L5 6.27A2 2 0 0 0 4 8v8a2 2 0 0 0 1 1.73l6 3.46a2 2 0 0 0 2 0l6-3.46A2 2 0 0 0 20 16z"/>
          </svg>
        </div>
        <span style="font-weight: 700; font-size: 1.1rem; color: var(--color-text);">Nura <span class="gradient-text">VetCare</span></span>
      </a>

      <!-- Links desktop -->
      <div class="nav-links" style="display: flex; align-items: center; gap: 2rem;">
        <a href="#features" style="font-size: 0.875rem; font-weight: 500; color: var(--color-text-2); text-decoration: none; transition: opacity 0.2s;" onmouseover="this.style.opacity='.6'" onmouseout="this.style.opacity='1'">Funciones</a>
        <a href="#pricing"  style="font-size: 0.875rem; font-weight: 500; color: var(--color-text-2); text-decoration: none; transition: opacity 0.2s;" onmouseover="this.style.opacity='.6'" onmouseout="this.style.opacity='1'">Precios</a>
        <a href="#social-proof" style="font-size: 0.875rem; font-weight: 500; color: var(--color-text-2); text-decoration: none; transition: opacity 0.2s;" onmouseover="this.style.opacity='.6'" onmouseout="this.style.opacity='1'">Clientes</a>
      </div>

      <!-- CTA -->
      <a href={CTA_URL} class="btn-primary" style="padding: 0.6rem 1.4rem; font-size: 0.875rem;">
        Empieza gratis
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</nav>

<style>
  @media (max-width: 767px) {
    .nav-links { display: none !important; }
  }
</style>
